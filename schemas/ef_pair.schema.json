{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtbflow.local/schemas/ef_pair.schema.json",
  "title": "xtbflow same-geometry energy-force pair",
  "type": "object",
  "required": ["pair_id", "source_record_id", "geometry_hash", "input_hash", "symbols", "coordinates", "charge", "multiplicity", "environment", "semi_empirical_protocol_id", "reference_protocol_id", "units", "status"],
  "additionalProperties": false,
  "properties": {
    "pair_id": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "geometry_hash": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "minLength": 1},
    "symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "coordinates": {"type": "array", "minItems": 1, "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false}},
    "charge": {"type": "integer"},
    "multiplicity": {"type": "integer", "minimum": 1},
    "environment": {"type": "object"},
    "semi_empirical_protocol_id": {"type": "string", "minLength": 1},
    "reference_protocol_id": {"type": "string", "minLength": 1},
    "units": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "status": {"enum": ["success", "failure"]},
    "semi_empirical_energy": {"type": ["number", "null"]},
    "semi_empirical_forces": {"type": ["array", "null"]},
    "reference_energy": {"type": ["number", "null"]},
    "reference_forces": {"type": ["array", "null"]},
    "delta_energy": {"type": ["number", "null"]},
    "delta_forces": {"type": ["array", "null"]},
    "error_category": {"type": ["string", "null"]},
    "error_message": {"type": ["string", "null"]}
  }
}
