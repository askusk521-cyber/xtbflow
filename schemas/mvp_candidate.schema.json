{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xtbflow-mvp-candidate/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "backend",
    "evidence_level",
    "candidate_index",
    "candidate_fingerprint",
    "input_id",
    "input_hash",
    "geometry_input_hash",
    "event",
    "coordinates_angstrom",
    "calculator",
    "protocol_id",
    "calculator_build_hash",
    "status",
    "reason_code",
    "attempt",
    "wall_seconds",
    "cpu_hours",
    "gpu_hours",
    "calculator_status",
    "calculator_calls"
  ],
  "properties": {
    "schema": {"const": "xtbflow-mvp-candidate/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "backend": {"enum": ["mock", "xtb"]},
    "evidence_level": {"enum": ["software_demo", "proxy_metric", "strict_validation"]},
    "candidate_index": {"type": "integer", "minimum": 0},
    "candidate_fingerprint": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "minLength": 1},
    "geometry_input_hash": {"type": "string", "minLength": 1},
    "event": {"type": "object"},
    "coordinates_angstrom": {"type": "array"},
    "calculator": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "calculator_build_hash": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "rejected", "failure"]},
    "reason_code": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "minimum": 1},
    "wall_seconds": {"type": "number", "minimum": 0},
    "cpu_hours": {"type": "number", "minimum": 0},
    "gpu_hours": {"type": "number", "minimum": 0},
    "calculator_status": {"type": "string", "minLength": 1},
    "calculator_calls": {"type": "integer", "minimum": 0},
    "energy_hartree": {"type": ["number", "null"]},
    "forces_hartree_per_angstrom": {"type": ["array", "null"]},
    "force_norm_hartree_per_angstrom": {"type": ["number", "null"]},
    "calculator_metadata": {"type": "object"}
  }
}
