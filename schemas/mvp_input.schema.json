{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xtbflow-mvp-input/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "input_id",
    "parent_reaction_id",
    "reaction_family_id",
    "symbols",
    "coordinates_angstrom",
    "charge",
    "multiplicity",
    "environment",
    "input_hash",
    "target_fields_read",
    "claim_limit"
  ],
  "properties": {
    "schema": {"const": "xtbflow-mvp-input/v1"},
    "input_id": {"type": "string", "minLength": 1},
    "parent_reaction_id": {"type": "string", "minLength": 1},
    "reaction_family_id": {"type": "string", "minLength": 1},
    "symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "coordinates_angstrom": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3}
    },
    "charge": {"type": "integer"},
    "multiplicity": {"type": "integer", "minimum": 1},
    "environment": {"type": "object"},
    "input_hash": {"type": "string", "minLength": 1},
    "target_fields_read": {"const": false},
    "claim_limit": {"type": "string", "minLength": 1}
  }
}
