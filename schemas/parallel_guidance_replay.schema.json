{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xtbflow-guidance/replay/v1",
  "title": "Deterministic parallel guidance replay",
  "type": "object",
  "required": ["schema", "mode", "candidate_pool_id", "random_seed", "budget", "initial_snapshot", "steps", "final_snapshot", "total_cost", "status", "claim_limits", "artifact_hash"],
  "properties": {
    "schema": {"const": "xtbflow-guidance-replay/v1"},
    "mode": {"enum": ["none", "geometry_only", "event_only", "parallel_geometry_event", "serial_baseline"]},
    "candidate_pool_id": {"type": "string", "minLength": 1},
    "random_seed": {"type": "integer", "minimum": 0},
    "budget": {"$ref": "#/$defs/cost"},
    "initial_snapshot": {"type": "object"},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "final_snapshot": {"type": "object"},
    "total_cost": {"$ref": "#/$defs/cost"},
    "status": {"enum": ["completed", "completed_with_rejections"]},
    "claim_limits": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "cost": {
      "type": "object",
      "required": ["model_forwards", "calculator_calls", "wall_seconds"],
      "properties": {
        "model_forwards": {"type": "integer", "minimum": 0},
        "calculator_calls": {"type": "integer", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
