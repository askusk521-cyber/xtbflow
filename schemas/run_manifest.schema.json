{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtbflow.local/schemas/run_manifest.schema.json",
  "title": "xtbflow frozen run manifest",
  "type": "object",
  "required": ["schema", "status", "spec", "budget", "environment"],
  "properties": {
    "schema": {"const": "xtbflow-run-manifest/v1"},
    "status": {"enum": ["prepared", "running", "completed", "failed", "cancelled"]},
    "spec": {
      "type": "object",
      "required": ["run_id", "phase", "task", "calculator", "protocol_id", "calculator_build_hash", "code_commit", "environment_digest", "ledger_id", "created_at"],
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "calculator": {"type": "string", "minLength": 1},
        "protocol_id": {"type": "string", "minLength": 1},
        "calculator_build_hash": {"type": "string", "minLength": 1},
        "code_commit": {"type": "string", "minLength": 1},
        "environment_digest": {"type": "string", "minLength": 1},
        "ledger_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1}
      }
    },
    "budget": {"type": "object", "required": ["phase", "max_concurrent_jobs", "max_retries_per_job", "max_wall_minutes_per_job"]},
    "environment": {"type": "object"}
  },
  "additionalProperties": false
}
