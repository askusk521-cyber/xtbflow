{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtbflow.org/schemas/search_attempt.schema.json",
  "title": "xtbflow independent search attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "attempt_id", "seed_id", "proposal_id", "stage", "status",
    "ledger_id", "protocol_id", "calculator", "raw_slot_id", "calculator_calls",
    "retry_index", "failure_reason", "output_index", "metadata"
  ],
  "properties": {
    "schema": {"const": "xtbflow-independent-search-attempt/v1"},
    "attempt_id": {"type": "string", "minLength": 1},
    "seed_id": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["not_searched", "unsafe", "unsupported", "numerical_failed", "budget_exhausted", "alternative_channel", "semiempirical_connected", "reference_single_point", "reference_path"]},
    "ledger_id": {"type": "string", "minLength": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "calculator": {"type": "string", "minLength": 1},
    "raw_slot_id": {"type": "integer", "minimum": 0},
    "calculator_calls": {"type": "integer", "minimum": 0},
    "retry_index": {"type": "integer", "minimum": 0},
    "failure_reason": {"type": ["string", "null"]},
    "output_index": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}
