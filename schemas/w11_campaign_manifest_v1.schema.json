{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtbflow.local/schemas/w11_campaign_manifest_v1.schema.json",
  "title": "XTBFlow W11 frozen campaign manifest",
  "description": "Reactant-only fixed-composition campaign input and fair comparison arms. Products, transition states and observed labels are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "status",
    "description",
    "source",
    "atom_pool",
    "candidates",
    "reference_protocol",
    "budget",
    "deduplication",
    "comparisons",
    "claim_limit",
    "frozen_at"
  ],
  "properties": {
    "schema_version": {"const": "xtbflow-w11-campaign/v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["development_screening", "frozen", "quarantine"]},
    "description": {"type": "string", "minLength": 1},
    "claim_limit": {"type": "string", "minLength": 1},
    "frozen_at": {"type": ["string", "null"]},
    "source": {"$ref": "#/$defs/source"},
    "atom_pool": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "reference_protocol": {"$ref": "#/$defs/reference_protocol"},
    "budget": {"$ref": "#/$defs/budget"},
    "deduplication": {"$ref": "#/$defs/deduplication"},
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/comparison"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["locator", "revision", "sha256", "license_record"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "license_record": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "role",
        "species_label",
        "explicit_hydrogens",
        "composition",
        "charge",
        "multiplicity",
        "input_locator",
        "input_sha256",
        "license_record"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["substrate", "co_reactant", "water", "buffer", "counterion", "spectator"]},
        "species_label": {"type": "string", "minLength": 1},
        "explicit_hydrogens": {"type": "boolean"},
        "composition": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "charge": {"type": "integer"},
        "multiplicity": {"type": "integer", "minimum": 1},
        "input_locator": {"type": "string", "minLength": 1},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "license_record": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "seed_id",
        "parent_system_id",
        "family_id",
        "geometry_locator",
        "geometry_sha256",
        "charge",
        "multiplicity",
        "component_ids",
        "water_roles",
        "input_origin",
        "provenance",
        "license_record",
        "status"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "seed_id": {"type": "string", "minLength": 1},
        "parent_system_id": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "geometry_locator": {"type": "string", "minLength": 1},
        "geometry_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"enum": ["unknown", "unresolved", "not_provided", "unverified"]}]},
        "charge": {"anyOf": [{"type": "integer"}, {"enum": ["unknown", "unresolved", "not_provided", "unverified"]}]},
        "multiplicity": {"anyOf": [{"type": "integer", "minimum": 1}, {"enum": ["unknown", "unresolved", "not_provided", "unverified"]}]},
        "component_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "water_roles": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["participating", "spectator", "unresolved"]}},
        "input_origin": {"const": "independent_reactant"},
        "provenance": {"type": "string", "minLength": 1},
        "license_record": {"type": "string", "minLength": 1},
        "status": {"enum": ["development", "quarantine"]},
        "missing": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "reference_protocol": {
      "type": "object",
      "additionalProperties": true,
      "required": ["protocol_id", "protocol_sha256", "method", "software", "version", "units"],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "method": {"type": "string", "minLength": 1},
        "software": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "units": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": true,
      "required": ["calculator_calls", "wall_seconds", "cpu_core_hours", "gpu_hours"],
      "properties": {
        "calculator_calls": {"type": "integer", "minimum": 1},
        "wall_seconds": {"type": "number", "minimum": 0},
        "cpu_core_hours": {"type": "number", "minimum": 0},
        "gpu_hours": {"type": "number", "minimum": 0}
      }
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": true,
      "required": ["keys", "within_parent_system", "cross_strategy"],
      "properties": {
        "keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "within_parent_system": {"type": "boolean"},
        "cross_strategy": {"type": "boolean"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "proposal_mode", "physics_mode", "candidate_ids", "budget_id", "input_fingerprint"],
      "properties": {
        "comparison_id": {"type": "string", "minLength": 1},
        "proposal_mode": {"enum": ["rule", "serial", "joint", "joint_agent"]},
        "physics_mode": {"enum": ["fixed", "adaptive"]},
        "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "budget_id": {"type": "string", "minLength": 1},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "agent_policy": {"type": "string", "minLength": 1}
      }
    }
  }
}
