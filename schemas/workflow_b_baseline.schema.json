{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/xtbflow/workflow_b_baseline.schema.json",
  "type": "object",
  "required": [
    "schema",
    "protocol_id",
    "status",
    "blocking_dependency",
    "first_scientific_matrix",
    "fairness",
    "required_run_identity",
    "metrics",
    "decision_gate",
    "evidence_boundary"
  ],
  "properties": {
    "schema": {"const": "xtbflow-workflow-b-baseline/v1"},
    "protocol_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["software_protocol_frozen_scientific_execution_blocked", "scientific_development_enabled_confirmatory_blocked"]},
    "first_scientific_matrix": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["arm_id", "kind", "implementation", "learned_control_mode", "conservation_projection"]
      }
    },
    "fairness": {
      "type": "object",
      "required": [
        "same_admitted_record_ids",
        "same_parent_group_split_fingerprint",
        "same_reactant_input_view_fingerprint",
        "learned_arms_share_trainable_parameter_count",
        "training_seeds",
        "generator_selection_calculator_calls_per_parent"
      ]
    },
    "decision_gate": {
      "type": "object",
      "required": [
        "title_claim_requires_joint_over_serial",
        "method_competitiveness_comparison",
        "coupling_attribution_requires_joint_over_current_one_way",
        "coupling_attribution_comparison",
        "conservation_ablation_comparison",
        "conservation_ablation_requires_only_projection_toggle"
      ],
      "properties": {
        "title_claim_requires_joint_over_serial": {"const": true},
        "method_competitiveness_comparison": {"const": "joint_event_geometry versus serial_event_to_geometry"},
        "coupling_attribution_requires_joint_over_current_one_way": {"const": true},
        "coupling_attribution_comparison": {"const": "joint_event_geometry versus current_event_to_geometry"},
        "conservation_ablation_requires_only_projection_toggle": {"const": true}
      }
    }
  }
}
